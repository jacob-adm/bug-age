# SPDX-License-Identifier: MIT OR Apache-2.0
# What the test suite reads, so the sdist can run it. Tests that need the example clones,
# cargo or Docker skip without them, as they do in a fresh checkout.
graft tests
graft targets
graft dist
graft results/oracle
include scripts/oracle_study.py
include docs/accuracy.md
global-exclude *.py[cod] __pycache__
